VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Email akun admin (Login Utama). Akun Firebase Auth dengan email PERSIS
# sama ini otomatis jadi admin: memakai database lama (config/customers/
# invoices) & bisa mengelola akun lain di menu "Daftar Akun".
# WAJIB huruf kecil semua (lowercase), dan harus SAMA PERSIS dengan
# email admin di Firestore Rules (lihat README).
VITE_ADMIN_EMAIL=admin@email-anda.com
