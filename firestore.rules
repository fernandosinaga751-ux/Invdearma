rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // GANTI dengan email admin Anda (huruf kecil, sama persis dengan VITE_ADMIN_EMAIL)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'admin@email-anda.com';
    }

    match /config/{doc}    { allow read, write: if isAdmin(); }
    match /customers/{doc} { allow read, write: if isAdmin(); }
    match /invoices/{doc}  { allow read, write: if isAdmin(); }

    match /accounts/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // ── BARU: link invoice untuk customer ──────────────────────────
    // Customer (tanpa login) hanya boleh MEMBACA satu dokumen lewat token
    // dan MENGUBAH field `proposal` (diskon & pajak). Tidak bisa list.
    match /shares/{token} {
      allow get: if true;
      allow list: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update: if
        (request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin()))
        || (
          resource.data.paid != true
          && resource.data.get('closed', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposal'])
          && request.resource.data.proposal.keys().hasOnly(['diskon','pajak','status','submittedAt'])
          && request.resource.data.proposal.status == 'pending'
          && request.resource.data.proposal.diskon is number
          && request.resource.data.proposal.pajak is number
          && request.resource.data.proposal.diskon >= 0
          && request.resource.data.proposal.pajak >= 0
        );
    }
  }
}
